+// Experiment: bound the F16 K-quant dispatch without changing its tiles or arithmetic.
+// Zero/unset keeps one block per work item. Positive values are blocks per CU.
+unsigned persistent_grid(unsigned bound) {
+    static const int per_cu = [] {
+        const char* v = std::getenv("STRATA_PF_F16_KQ_PERSIST");
+        return v ? std::clamp(std::atoi(v), 0, 16) : 0;
+    }();
+    if (per_cu == 0) return 0;
+    int device = 0;
+    if (cudaGetDevice(&device) != cudaSuccess) {
+        std::fprintf(stderr, "F16 K-quant dispatch: cannot inspect the current GPU\n");
+        std::exit(1);
+    }
+    static std::mutex mutex;
+    static std::map<int, int> cu_counts;
+    std::lock_guard<std::mutex> lock(mutex);
+    auto it = cu_counts.find(device);
+    if (it == cu_counts.end()) {
+        cudaDeviceProp prop{};
+        if (cudaGetDeviceProperties(&prop, device) != cudaSuccess || prop.multiProcessorCount <= 0) {
+            std::fprintf(stderr, "F16 K-quant dispatch: cannot inspect GPU %d's CU count\n", device);
+            std::exit(1);
+        }
+        it = cu_counts.emplace(device, prop.multiProcessorCount).first;
+        std::fprintf(stderr, "strata: F16 K-quant persistent dispatch: %d blocks/CU, GPU %d, %d CUs (opt-in)\n",
+                     per_cu, device, it->second);
+    }
+    return std::min(bound, (unsigned) (it->second * per_cu));
+}
